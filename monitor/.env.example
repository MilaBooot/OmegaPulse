OMA_MONITOR_AUTH_DB=monitor/.local/auth/users.sqlite3
OMA_MONITOR_CONTAINER=omega
OMA_MONITOR_HOST=127.0.0.1
OMA_MONITOR_PORT=8765
# Set false only for local HTTP; HTTPS deployments keep true.
OMA_MONITOR_COOKIE_SECURE=true
OMA_MONITOR_SECURITY_EVENTS_FILE=
OMA_MONITOR_LOG_MAX_BYTES=20480
OMA_MONITOR_LOG_INTERVAL_SECONDS=3600
OMA_MONITOR_LOG_KEEP=10
